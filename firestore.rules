rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Submissions: all authenticated app users can read/write
    match /submissions/{docId} {
      allow read, write: if true;
    }
    // Users: all authenticated app users can read/write
    match /users/{docId} {
      allow read, write: if true;
    }
    // Messages: all authenticated app users can read/write
    match /messages/{docId} {
      allow read, write: if true;
    }
    // Audit Logs: all authenticated app users can read/write
    match /auditLogs/{docId} {
      allow read, write: if true;
    }
  }
}
