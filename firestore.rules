rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Submissions: all app users can read/write
    match /submissions/{docId} {
      allow read, write: if true;
    }
    // Users: all app users can read/write
    match /users/{docId} {
      allow read, write: if true;
    }
    // Messages (chat): all app users can read/write
    match /messages/{docId} {
      allow read, write: if true;
    }
    // Audit Logs
    match /audit_logs/{docId} {
      allow read, write: if true;
    }
    // Legacy auditLogs (backward compat)
    match /auditLogs/{docId} {
      allow read, write: if true;
    }
    // Shift Reports (Historial de Turnos)
    match /reportes_turnos/{docId} {
      allow read, write: if true;
    }
    // Shift Report Drafts (Borradores de Turno)
    match /borradores_turnos/{docId} {
      allow read, write: if true;
    }
    // Submission images (legacy)
    match /submission_images/{docId} {
      allow read, write: if true;
    }
  }
}
